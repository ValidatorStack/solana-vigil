{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["solana", "validator", "vigil", "alpenglow"],
  "templating": {"list": [{"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "label": "Prometheus"}]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "utc",
  "title": "Vigil — Solana Validator",
  "uid": "vigil-solana-validator",
  "version": 1,
  "panels": [
    {"type": "stat", "title": "VAT runway (epochs)", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "fieldConfig": {"defaults": {"min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 2}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "value_and_name"}, "targets": [{"expr": "solana_vat_runway_epochs", "refId": "A"}]},
    {"type": "stat", "title": "Next epoch VAT sufficient", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "NO", "color": "red"}, "1": {"text": "YES", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "textMode": "value"}, "targets": [{"expr": "solana_vat_next_epoch_sufficient", "refId": "A"}]},
    {"type": "stat", "title": "BLS registered", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "MISSING / INVALID", "color": "red"}, "1": {"text": "REGISTERED", "color": "green"}}}]}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "textMode": "value"}, "targets": [{"expr": "solana_bls_registered", "refId": "A"}]},
    {"type": "stat", "title": "Delinquent", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "NO", "color": "green"}, "1": {"text": "YES", "color": "red"}}}]}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "textMode": "value"}, "targets": [{"expr": "solana_delinquent", "refId": "A"}]},
    {"type": "timeseries", "title": "Vote account balance above rent", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"expr": "solana_vat_spendable_sol", "legendFormat": "Spendable SOL", "refId": "A"}, {"expr": "solana_vat_lamports_per_epoch / 1000000000", "legendFormat": "One epoch VAT", "refId": "B"}]},
    {"type": "timeseries", "title": "Leader production", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "fieldConfig": {"defaults": {"custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"expr": "solana_leader_slots", "legendFormat": "Leader slots", "refId": "A"}, {"expr": "solana_blocks_produced", "legendFormat": "Produced", "refId": "B"}, {"expr": "solana_leader_missed_slots", "legendFormat": "Missed", "refId": "C"}]},
    {"type": "timeseries", "title": "Leader skip ratio", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"lineWidth": 2, "fillOpacity": 15, "showPoints": "never"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.15}]}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}}, "targets": [{"expr": "solana_leader_skip_ratio", "refId": "A"}]},
    {"type": "timeseries", "title": "Local / reference slot lag", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "fieldConfig": {"defaults": {"unit": "none", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 15, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}}, "targets": [{"expr": "solana_slot_lag", "legendFormat": "Slots behind", "refId": "A"}]},
    {"type": "state-timeline", "title": "Check status", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 10, "w": 24, "x": 0, "y": 21}, "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "OK", "color": "green"}, "1": {"text": "WARNING", "color": "yellow"}, "2": {"text": "CRITICAL", "color": "red"}, "3": {"text": "UNKNOWN", "color": "purple"}}}], "custom": {"fillOpacity": 80, "lineWidth": 0}}, "overrides": []}, "options": {"alignValue": "left", "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "mergeValues": false, "rowHeight": 0.8, "showValue": "auto", "tooltip": {"mode": "single", "sort": "none"}}, "targets": [{"expr": "vigil_check_status", "legendFormat": "{{check}}", "refId": "A"}]}
  ]
}
